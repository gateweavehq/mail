# Copied to .dev.vars by `pnpm dev:setup`, which also fills in a random secret.
# The "Deploy to Cloudflare" button asks for every key set here, so the optional ones stay
# commented out. Uncomment one to use it.

# Signs sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional: enables "Sign in with GitHub". Callback URL: http://localhost:4750/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional: enables signing in through an OpenID Connect provider. Needs the first three; see
# docs/self-hosting.md. Callback URL: http://localhost:4750/api/auth/callback/oidc
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=

# Optional: pins the app's URL. Leave it out to accept any host, for example from your phone.
# BETTER_AUTH_URL=

# Optional: turns on email (invitations, password reset), such as "Gateweave Mail <mail@example.com>".
# In local dev nothing is sent: each email is printed in the terminal and saved to a file.
# EMAIL_FROM=

# Optional: how many messages one workspace may send from its mailboxes a day. 200 when unset.
# Mail people write in local dev isn't sent either: it is printed and saved the same way.
# SEND_PER_DAY=

# Optional: "off" sends mail to this deployment's own addresses through the provider too. Unset,
# a message whose every recipient is an address here goes straight to their mailboxes.
# DIRECT_DELIVERY=

# Optional: encrypts the keys workspaces keep here, such as a Resend key, which can't be added
# without it. 32 random bytes, base64: openssl rand -base64 32. `pnpm dev:setup` fills one in.
# SECRETS_KEY=
# When changing it, the key before, which then only opens what it encrypted (docs/self-hosting.md).
# SECRETS_KEY_PREVIOUS=

# Optional: your account id and an API token with Email Sending: Edit, so that removing an address
# from a workspace's suppressions also takes it off Email Service's own list, for that workspace's
# domains. Without them, only you can take it off there.
# EMAIL_SENDING_ACCOUNT_ID=
# EMAIL_SENDING_API_TOKEN=

# Optional: the addresses of your legal pages, linked from the sign-in pages and the workspace menu.
# Nothing is linked when they are unset.
# LEGAL_NOTICE_URL=
# PRIVACY_POLICY_URL=
# TERMS_URL=

# Optional: the DNS-over-HTTPS resolver that checks a domain's records, answering in JSON.
# Cloudflare's when unset, which is what a deployment wants.
# DNS_RESOLVER_URL=
