{
	"name": "@gateweave/mail-web",
	"version": "0.0.0",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 4750 --strictPort",
		"dev:setup": "node scripts/dev-setup.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "node scripts/deploy.mjs",
		"deploy:staging": "vite build --mode staging && wrangler deploy --cwd ../..",
		"typegen": "wrangler types && tsr generate",
		"typecheck": "wrangler types && tsr generate && tsc && tsc -p scripts && tsc -p test && tsc -p e2e",
		"test": "vitest run",
		"test:e2e": "vite build && playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
		"auth:schema": "pnpm dlx auth@1.7.16 generate --config src/server/auth/cli.ts --output src/server/db/auth-schema.ts --yes"
	},
	"dependencies": {
		"@better-auth/core": "1.7.16",
		"@fontsource-variable/inter": "5.3.0",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.4",
		"better-auth": "1.7.16",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"drizzle-orm": "catalog:",
		"jose": "6.2.15",
		"lucide-react": "1.66.0",
		"radix-ui": "1.8.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"sonner": "2.0.8",
		"tailwind-merge": "3.7.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@cloudflare/vite-plugin": "1.67.0",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/devtools-vite": "0.8.6",
		"@tanstack/react-devtools": "0.10.14",
		"@tanstack/react-router-devtools": "1.167.2",
		"@tanstack/router-cli": "1.167.46",
		"@types/node": "catalog:",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.2.1",
		"drizzle-kit": "catalog:",
		"miniflare": "5.20261023.0-beta",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	}
}
