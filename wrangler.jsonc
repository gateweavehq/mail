// Mail deploys from the repository root, where the "Deploy to Cloudflare" button looks for this
// file; the app itself lives in apps/web, which runs Wrangler and Vite against it.
{
	"$schema": "apps/web/node_modules/wrangler/config-schema.json",
	"name": "gateweave-mail",
	"main": "apps/web/src/server.ts",
	"compatibility_date": "2026-10-01",
	// `global_fetch_strictly_public`: a request Mail makes, such as a webhook's, to a host on its own
	// zone goes in through Cloudflare like anyone's, past its security settings and to the Worker
	// that serves it, never straight to the origin behind them.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Settings made in the dashboard stay through a deploy. Wrangler otherwise removes a plain-text
	// variable it does not find here, so the next push would quietly take away a setting.
	"keep_vars": true,
	// Wrangler will not build a branch's Preview without this block, which would fail every push to a
	// branch, Dependabot's included. A Preview gets none of this file's bindings and none of the
	// Worker's secrets, so it only says that it is not set up. docs/self-hosting.md has the rest.
	"previews": {},
	"observability": { "enabled": true },
	"upload_source_maps": true,
	// Once a day, deletes sessions and invitations past their time. Environments inherit this.
	"triggers": { "crons": ["29 3 * * *"] },
	// Accounts and the list of workspaces. The database is provisioned on first deploy.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gateweave-mail",
			"migrations_dir": "apps/web/migrations"
		}
	],
	// Mail as it arrived, one object per message under <workspace>/<mailbox>/. The bucket is
	// provisioned on first deploy, like the database.
	"r2_buckets": [{ "binding": "RAW_MAIL", "bucket_name": "gateweave-mail" }],
	// Rate limits on sign-in, password reset and email are counted in one Durable Object per client
	// address or recipient. Each mailbox has one too, which holds the index of its messages, and each
	// workspace one for its webhooks and one for its audience (its templates).
	"durable_objects": {
		"bindings": [
			{ "name": "RATE_LIMITER", "class_name": "RateLimiter" },
			{ "name": "MAILBOX", "class_name": "Mailbox" },
			{ "name": "WEBHOOKS", "class_name": "Webhooks" },
			{ "name": "AUDIENCE", "class_name": "Audience" }
		]
	},
	"exports": {
		"RateLimiter": { "type": "durable-object", "storage": "sqlite" },
		"Mailbox": { "type": "durable-object", "storage": "sqlite" },
		"Webhooks": { "type": "durable-object", "storage": "sqlite" },
		"Audience": { "type": "durable-object", "storage": "sqlite" }
	},
	// Email through Cloudflare Email Service. Nothing is sent until EMAIL_FROM names a sender on a
	// domain onboarded to Email Sending; without it, Mail runs with email off.
	"send_email": [{ "name": "EMAIL" }],
	// Email Service's delivery events: each sending domain gets an event subscription that publishes
	// to this queue (docs/self-hosting.md). The Deploy button and `pnpm run deploy` create the queue.
	"queues": {
		"consumers": [
			{
				"queue": "gateweave-mail-events",
				"max_batch_size": 50,
				"max_batch_timeout": 5,
				"max_retries": 15
			}
		]
	},
	// Optional: GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, OIDC_ISSUER, OIDC_CLIENT_ID,
	// OIDC_CLIENT_SECRET, OIDC_PROVIDER_NAME, BETTER_AUTH_URL, EMAIL_FROM, the legal page
	// addresses and DURABLE_OBJECT_JURISDICTION (see apps/web/src/server/env.d.ts).
	"secrets": { "required": ["BETTER_AUTH_SECRET"] },
	// The top level is what self-hosters deploy. Gateweave Cloud deploys the environments below:
	// `cloud` is https://mail.gateweave.com, the Worker the top level names, and `staging` a
	// separate Worker with its own database. Bindings are not inherited, so each repeats them.
	"env": {
		// Everything `cloud` keeps stays in the EU. Its database, its bucket and its queue were made
		// with the `eu` jurisdiction, which nothing can change afterwards, and its Durable Objects
		// (mailboxes, webhooks, audiences, rate limits) go there by DURABLE_OBJECT_JURISDICTION,
		// which `pnpm run deploy` also reads to make a missing queue there. The Worker runs in
		// Frankfurt, as Gateweave ID's does, near the database (D1 says EEUR), so the queries a
		// request makes one after another don't each cross an ocean. docs/self-hosting.md,
		// "Gateweave Cloud", has the rest.
		"cloud": {
			"name": "gateweave-mail",
			"routes": [{ "pattern": "mail.gateweave.com", "custom_domain": true }],
			"placement": { "region": "aws:eu-central-1" },
			"vars": { "DURABLE_OBJECT_JURISDICTION": "eu" },
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "gateweave-mail-eu",
					"database_id": "c0c5468c-f84b-45b8-a804-6412544febef",
					"migrations_dir": "apps/web/migrations"
				}
			],
			"r2_buckets": [
				{ "binding": "RAW_MAIL", "bucket_name": "gateweave-mail-eu", "jurisdiction": "eu" }
			],
			"durable_objects": {
				"bindings": [
					{ "name": "RATE_LIMITER", "class_name": "RateLimiter" },
					{ "name": "MAILBOX", "class_name": "Mailbox" },
					{ "name": "WEBHOOKS", "class_name": "Webhooks" },
					{ "name": "AUDIENCE", "class_name": "Audience" }
				]
			},
			"send_email": [{ "name": "EMAIL" }],
			"queues": {
				"consumers": [
					{
						"queue": "gateweave-mail-events-eu",
						"max_batch_size": 50,
						"max_batch_timeout": 5,
						"max_retries": 15
					}
				]
			},
			"secrets": { "required": ["BETTER_AUTH_SECRET"] }
		},
		"staging": {
			"name": "gateweave-mail-staging",
			"routes": [{ "pattern": "mail-staging.gateweave.com", "custom_domain": true }],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "gateweave-mail-staging",
					"database_id": "cc70b21d-878d-449d-b032-6e6af4577d87",
					"migrations_dir": "apps/web/migrations"
				}
			],
			"r2_buckets": [{ "binding": "RAW_MAIL", "bucket_name": "gateweave-mail-staging" }],
			"durable_objects": {
				"bindings": [
					{ "name": "RATE_LIMITER", "class_name": "RateLimiter" },
					{ "name": "MAILBOX", "class_name": "Mailbox" },
					{ "name": "WEBHOOKS", "class_name": "Webhooks" },
					{ "name": "AUDIENCE", "class_name": "Audience" }
				]
			},
			"send_email": [{ "name": "EMAIL" }],
			"queues": {
				"consumers": [
					{
						"queue": "gateweave-mail-staging-events",
						"max_batch_size": 50,
						"max_batch_timeout": 5,
						"max_retries": 15
					}
				]
			},
			"secrets": { "required": ["BETTER_AUTH_SECRET"] }
		}
	}
}
